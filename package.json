{
  "name": "mvp-prototype",
  "version": "0.0.1",
  "private": true,
  "description": "MVP prototype: L1 5-primitive scheduler with mock-first testing strategy",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:coverage:html": "vitest run --coverage --reporter=html",
    "test:a00": "vitest run tests/phase-a/tier-a00",
    "test:phase-a": "vitest run tests/phase-a",
    "typecheck": "tsc --noEmit -p tsconfig.test.json"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^1.6.1",
    "autoprefixer": "^10.5.5",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^1.2.0"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@monaco-editor/react": "^4.7.0",
    "@types/dagre": "^0.7.54",
    "dagre": "^0.8.5",
    "fast-xml-parser": "^5.11.1",
    "fastify": "^5.12.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "reactflow": "^11.11.4",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  }
}
