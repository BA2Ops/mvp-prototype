[
  {
    "n": 1,
    "title": "调用 mock_op：x → x*2",
    "slug": "basic-mock-op",
    "kind": "positive",
    "purpose": "最基础的端到端：读 inputs → 调 handler → 写 outputs → 标 done → 弹栈。",
    "preparation": "internalStore.set('$r0', 5)\nentry=mock_op(inputs:{x:$r0}, outputs:{result:$r1})",
    "assertion": "$r1 === 10\ntracker.getCallCount() === 1\ncalls[0].inputs.x === 5\nentry.status === 'done'\nstack.length === 0",
    "note": "execute_op 最常见的 happy path——五件事一气呵成。",
    "view": "register",
    "state": {
      "stack_before": [
        "move_entry"
      ],
      "stack_after": [],
      "int_before": {
        "$r0": "5"
      },
      "int_after": {
        "$r0": "5",
        "$r1": "10"
      },
      "pub_before": null,
      "pub_after": null,
      "entry_before": "pending",
      "entry_after": "done",
      "error": null
    },
    "action": "mock_op(x=5) → 10"
  },
  {
    "n": 2,
