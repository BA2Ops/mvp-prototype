[
  {
    "n": 1,
    "title": "调用 L3.compile，children 压入帧之上（帧保留）",
    "slug": "basic-frame-retention",
    "kind": "positive",
    "purpose": "验证 executeIntent 把 L3.compile 返回的 children 逆序压栈到 entry 之上，entry 自身保留在栈底。",
    "preparation": "createMockL3([c1, c2]) 两个 skip_n\nentry 推入栈底",
    "assertion": "stack.length === 3\n[entry.id, 'c2', 'c1']\n依次 pop 得 c1 → c2 → entry",
    "note": "帧保留——entry 不被弹出，children 逆序压栈。",
    "view": "stack",
    "state": {
      "stack_before": [
        "entry"
      ],
      "stack_after": [
        "entry",
        "c2",
        "c1"
      ],
      "int_before": null,
      "int_after": null,
      "pub_before": null,
      "pub_after": null,
      "entry_before": "pending",
      "entry_after": "awaiting_children",
      "error": null
    },
    "action": "L3.compile([c1, c2])\n逆序压栈"
  },
  {
    "n": 2,
    "title": "children 压栈顺序：children[0] 在栈顶（先执行）",
    "slug": "children-order",
    "kind": "positive",
    "purpose": "三个 children 时仍维持 children[0] 最先出栈的逆序语义。",
    "preparation": "createMockL3([first, middle, last]) 三个 skip_n",
    "assertion": "stack.map(e=>e.id) === [entry.id, 'last', 'middle', 'first']\n逐 pop 出 first/middle/last/entry",
    "note": "children[0] 必须先执行——逆序约定。",
    "view": "stack",
    "state": {
